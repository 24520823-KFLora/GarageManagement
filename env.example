# ==================================================
# AutoGara — Biến môi trường
# Sao chép file này thành .env và điền giá trị thật
# KHÔNG commit file .env lên GitHub
# ==================================================

# Chuỗi kết nối PostgreSQL (lấy từ Neon.tech hoặc DB local)
# Ví dụ Neon: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Khoá bí mật ký JWT — đặt chuỗi ngẫu nhiên, tối thiểu 32 ký tự
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-at-least-32-characters

# Môi trường chạy: development | production
NODE_ENV=development

# Cổng HTTP (Render.com tự cấp biến này, không cần đặt tay khi deploy)
PORT=3000
